{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canvas-hub-allowance-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "AllowanceGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AllowanceGateway"] }],
  "vars": {
    // Deliberately no funded allowance. These are operator-selected limits,
    // not a product promise. Rates below are synthetic for the mock adapter.
    "POLICY": {
      "version": 1,
      "user_daily_microusd": 0,
      "user_monthly_microusd": 0,
      "global_monthly_microusd": 0,
      "global_lifetime_microusd": 0,
      "session_ttl_seconds": 2592000,
      "invite_ttl_max_seconds": 86400,
      "request_timeout_ms": 30000,
      "max_body_bytes": 65536,
      "max_stream_bytes": 262144,
      "user_concurrency": 2,
      "global_concurrency": 8,
      "user_requests_per_minute": 60,
      "ingress_per_minute": 120,
      "global_ingress_per_minute": 600,
      "auth_attempts_per_minute": 10,
      "admin_attempts_per_minute": 30,
      "max_users": 100,
      "models": {
        "mock-text": {
          "provider": "mock",
          "max_input_tokens": 8192,
          "max_output_tokens": 1024,
          "input_microusd_per_million_tokens": 1000000,
          "output_microusd_per_million_tokens": 2000000
        }
      },
      "tools": {
        "demo_read_only": {
          "description": "Offline demonstration function; execution is the local caller's responsibility.",
          "parameters": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    }
  }
}
